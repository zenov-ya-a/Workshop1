#! /usr/bin/gnuplot -persist

set datafile separator ';'

# set term qt 0 title "Data"
set terminal png size 800,600
set output "plot_data.png"
set title "Распредление данных"
set key left bottom Left reverse samplen 2

set grid
set xlabel "N"
set ylabel "Частота, Гц"

data_file = "lab_table.csv"

f(x) = a * x + b
fit f(x) data_file using 1:2 via a, b

plot data_file using 1:2 with points pt 7 ps 1.5 title "Эксперементальные данные", f(x) with lines title "Линия тренда"

# set term qt 1 title "Гистограмма"
set terminal png size 800,600
set output "gistogram.png"
set title "Гистограмма"
set offsets graph 0.1, graph 0.1
set key left top

set grid
set xlabel "Частота, Гц"
set ylabel "dN / (N  d)"

set style fill solid 1.0 border -1

plot "gistogram.csv" using 1:2 with boxes title ""
